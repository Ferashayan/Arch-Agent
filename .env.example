GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024

# Floor plan image model & Exterior design model (change this to swap models, no code edit needed)
FLOOR_PLAN_MODEL=gemini-3.1-flash-image
EXTERIOR_DESIGN_MODEL=gemini-3.1-flash-image

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=arch-agent
PINECONE_NAMESPACE=saudi-building-code

RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# FastAPI Server Settings
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

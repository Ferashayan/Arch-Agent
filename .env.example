GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Alibaba DashScope — used by floor_plan_service via OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your-dashscope-api-key

# Floor plan image model (change this to swap models, no code edit needed)
# Default: wan2.7-image-pro
FLOOR_PLAN_MODEL=wan2.7-image-pro

PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=arch-agent
PINECONE_NAMESPACE=saudi-building-code

RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
